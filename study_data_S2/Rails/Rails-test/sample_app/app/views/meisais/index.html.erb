<p style="color: green"><%= notice %></p>

<% content_for :title, "Meisais" %>

<h1>Meisais</h1>

<div id="meisais">
  <% @meisais.each do |meisai| %>
    <%= render meisai %>
    <p>
      <%= link_to "Show this meisai", meisai %>
    </p>
  <% end %>
</div>

<%= link_to "New meisai", new_meisai_path %>
